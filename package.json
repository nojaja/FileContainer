{
    "name": "@nojaja/filecontainer",
    "version": "1.0.2",
    "description": "File container and management utility class for JavaScript applications",
    "keywords": ["file", "container", "file-management", "javascript", "file-data"],
    "main": "./dist/bundle.js",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "scripts": {
        "test": "cross-env NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=test webpack && jest",
        "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider webpack",
        "dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider webpack --mode development --watch",
        "start": "cross-env NODE_OPTIONS=--openssl-legacy-provider webpack-dev-server"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nojaja/FileContainer.git"
    },
    "author": "nojaja",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/nojaja/FileContainer/issues"
    },
    "homepage": "https://github.com/nojaja/FileContainer#readme",
    "devDependencies": {
        "@babel/core": "^7.14.3",
        "@babel/preset-env": "^7.14.4",
        "babel-jest": "^25.5.1",
        "cross-env": "^10.1.0",
        "jest": "^25.5.4",
        "webpack": "^4.46.0",
        "webpack-cli": "^3.3.12",
        "webpack-dev-server": "^3.11.2"
    }
}